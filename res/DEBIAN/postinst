#!/bin/bash

set -e

if [ "$1" = configure ]; then

	INITSYS=$(ls -al /proc/1/exe | awk -F' ' '{print $NF}' | awk -F'/' '{print $NF}')
	ln -f -s /usr/share/gdeskremoto/gdeskremoto /usr/bin/gdeskremoto

	if [ "systemd" == "$INITSYS" ]; then

		if [ -e /etc/systemd/system/gdeskremoto.service ]; then
			rm -f /etc/systemd/system/gdeskremoto.service /usr/lib/systemd/system/gdeskremoto.service /usr/lib/systemd/user/gdeskremoto.service >/dev/null  2>&1
		fi
		mkdir -p /usr/lib/systemd/system/
		cp /usr/share/gdeskremoto/files/systemd/gdeskremoto.service /usr/lib/systemd/system/gdeskremoto.service
		# try fix error in Ubuntu 18.04
		# Failed to reload gdeskremoto.service: Unit gdeskremoto.service is not loaded properly: Exec format error.
		# /usr/lib/systemd/system/gdeskremoto.service:10: Executable path is not absolute: pkill -f "gdeskremoto --"
		if [ -e /usr/bin/pkill ]; then
			sed -i "s|pkill|/usr/bin/pkill|g" /usr/lib/systemd/system/gdeskremoto.service
		fi
		systemctl daemon-reload
		systemctl enable gdeskremoto
		systemctl start gdeskremoto
	fi
fi
